# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Bot token obtained from @BotFather (required).
BOT_TOKEN=

# Telegram chat id of the duty-developer group where tickets are posted (required).
DEV_CHAT_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy async URL (asyncpg driver). Inside docker compose this is overridden
# to point at the `db` service; for local runs use localhost + the host port.
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5433/support

# ---------------------------------------------------------------------------
# Bootstrap admins
# ---------------------------------------------------------------------------
# Comma-separated Telegram user ids that receive the `admin` role on first /start.
BOOTSTRAP_ADMIN_IDS=123,456

# ---------------------------------------------------------------------------
# Bot runtime
# ---------------------------------------------------------------------------
# How the bot receives updates: "webhook" or "polling".
BOT_MODE=polling

# Shared secret sent as X-Telegram-Bot-Api-Secret-Token on webhook updates.
WEBHOOK_SECRET=

# Public HTTPS URL Telegram should POST updates to (webhook mode only).
WEBHOOK_URL=

# Timeout (seconds) for a webhook update request.
WEBHOOK_UPDATE_TIMEOUT=30

# ---------------------------------------------------------------------------
# Telegram Mini App / initData
# ---------------------------------------------------------------------------
# Max age (seconds) of a Telegram Mini App initData payload before it is rejected.
INIT_DATA_MAX_AGE=86400

# ---------------------------------------------------------------------------
# Drafts
# ---------------------------------------------------------------------------
# Time-to-live (seconds) of an unfinished ticket draft.
DRAFT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Reminders
# ---------------------------------------------------------------------------
# Interval (seconds) before the next reminder per priority.
REMINDER_CRITICAL_SECONDS=600
REMINDER_HIGH_SECONDS=1800
REMINDER_MEDIUM_SECONDS=7200
REMINDER_LOW_SECONDS=28800

# How often (seconds) the reminder loop scans for due tickets.
REMINDER_POLL_INTERVAL=30

# ---------------------------------------------------------------------------
# Background tasks
# ---------------------------------------------------------------------------
# How often (seconds) the post-sync loop scans for stale posts.
POST_SYNC_POLL_INTERVAL=10

# Timeout (seconds) for acquiring the per-ticket advisory lock.
ADVISORY_LOCK_TIMEOUT=10

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Port the FastAPI app listens on.
APP_PORT=8000

# Port the Prometheus /metrics endpoint listens on.
METRICS_PORT=9090

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# "json" or "dev".
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
# Sentry DSN. When empty, Sentry is not initialized.
SENTRY_DSN=

SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
# Retention (seconds) for processed_update dedup rows.
PROCESSED_UPDATES_RETENTION=172800
