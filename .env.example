# Telegram bot token from BotFather
BOT_TOKEN=
# polling for local development, webhook in production
BOT_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
DEV_CHAT_ID=0
MINIAPP_URL=https://example.invalid
BOOTSTRAP_ADMIN_IDS=
# PostgreSQL async URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support
HOST=0.0.0.0
PORT=8000
METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
WEBHOOK_TIMEOUT_SECONDS=20
INIT_DATA_MAX_AGE_SECONDS=3600
UPDATE_RETENTION_HOURS=48
DRAFT_TTL_HOURS=24
REMINDER_POLL_SECONDS=15
SYNC_POLL_SECONDS=5
CRITICAL_REMINDER_MINUTES=10
HIGH_REMINDER_MINUTES=30
MEDIUM_REMINDER_MINUTES=120
LOW_REMINDER_MINUTES=480
