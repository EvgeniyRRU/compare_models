# Telegram bot token from BotFather (secret; in production comes from external env pipeline)
BOT_TOKEN=123456:ABC-DEF...

# polling (local dev, no public HTTPS needed) | webhook (production)
BOT_MODE=polling

# Secret checked in X-Telegram-Bot-Api-Secret-Token header of webhook updates (webhook mode)
WEBHOOK_SECRET_TOKEN=change…ring

# Telegram chat id of the developers channel/group where ticket posts are published
DEV_CHAT_ID=-1001234567890

# Comma-separated telegram ids that get 'admin' role on their first /start
BOOTSTRAP_ADMIN_IDS=11111111,22222222

# PostgreSQL DSN (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://rent:rent@localhost:5433/rent_bot

# HTTP ports
PORT=8000
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Mini App initData auth_date freshness limit, seconds
AUTH_DATE_MAX_AGE_SECONDS=3600

# Public https URL of the Mini App (empty = no web-app menu button)
WEB_APP_URL=

# Background: postgres advisory lock wait for per-ticket post sync, seconds
ADVISORY_LOCK_TIMEOUT_SECONDS=10

# Background: dedupe table retention, hours
PROCESSED_UPDATES_TTL_HOURS=48

# Webhook: max seconds to process a single update synchronously
PROCESS_UPDATE_TIMEOUT_SECONDS=30

# Background tasks intervals, seconds
POST_SYNC_INTERVAL_SECONDS=30
REMINDER_POLL_INTERVAL_SECONDS=30

# Telegram API retry attempts with backoff (429 retry_after is honored)
TG_RETRY_ATTEMPTS=5

# Ticket-creation draft TTL, hours
DRAFT_TTL_HOURS=24

# Reminder intervals by priority, minutes
REMINDER_INTERVAL_CRITICAL_MIN=10
REMINDER_INTERVAL_HIGH_MIN=30
REMINDER_INTERVAL_MEDIUM_MIN=120
REMINDER_INTERVAL_LOW_MIN=480

# Optional: Sentry DSN; Sentry is disabled when empty
SENTRY_DSN=
