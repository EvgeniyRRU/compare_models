# Токен BotFather и секрет для проверки webhook
BOT_TOKEN=replace-me
WEBHOOK_SECRET=replace-me
# PostgreSQL внутри Compose
DATABASE_URL=postgresql+asyncpg://support:support@db:5432/support
# Чат разработчиков и публичный HTTPS-адрес Mini App
DEV_CHAT_ID=-1001234567890
MINI_APP_URL=https://example.com/
# Локально polling; в production webhook
BOT_MODE=polling
# JSON-массив Telegram ID первичных администраторов
BOOTSTRAP_ADMIN_IDS=[]
# Время жизни черновиков и допустимый возраст initData
DRAFT_TTL_HOURS=24
INIT_DATA_MAX_AGE_SECONDS=3600
# Таймаут обработки и интервалы опроса фоновых задач в секундах
WEBHOOK_TIMEOUT_SECONDS=20
REMINDER_POLL_SECONDS=30
SYNC_POLL_SECONDS=30
# Отдельный порт метрик; Sentry отключён при пустом DSN
METRICS_PORT=9090
SENTRY_DSN=
# Уровень логов и формат json или console
LOG_LEVEL=INFO
LOG_FORMAT=json
# Интервалы напоминаний в минутах
REMINDER_CRITICAL_MINUTES=10
REMINDER_HIGH_MINUTES=30
REMINDER_MEDIUM_MINUTES=120
REMINDER_LOW_MINUTES=480
