# Local configuration only. Supply production secrets through the environment.
# Obtain a real token from BotFather. This placeholder is not a credential.
BOT_TOKEN=replace_with_botfather_token
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
# polling is local single-replica mode; webhook supports multiple replicas.
BOT_MODE=polling
# Developer group/supergroup Telegram chat ID (normally negative).
DEV_CHAT_ID=-1001234567890
# Comma-separated IDs or a JSON array. Granted once, on the user's first /start.
BOOTSTRAP_ADMIN_IDS=[]
# Public HTTPS Mini App URL. Empty disables its private-chat menu button.
MINI_APP_URL=
# Public HTTPS webhook URL used by the explicit registration command.
WEBHOOK_URL=
# Required in webhook mode: 1–256 letters, digits, underscores or hyphens.
WEBHOOK_SECRET=
# Maximum processing attempt duration, in seconds.
UPDATE_TIMEOUT_SECONDS=30
# Signed Mini App data lifetime and permitted future clock skew, seconds.
INIT_DATA_MAX_AGE_SECONDS=3600
AUTH_CLOCK_SKEW_SECONDS=30
# Draft inactivity TTL in hours.
DRAFT_TTL_HOURS=24
# Priority reminder intervals in seconds: 10 min / 30 min / 2 h / 8 h.
REMINDER_CRITICAL_SECONDS=600
REMINDER_HIGH_SECONDS=1800
REMINDER_MEDIUM_SECONDS=7200
REMINDER_LOW_SECONDS=28800
# Worker polling intervals and maximum batch size.
REMINDER_POLL_SECONDS=15
POST_SYNC_POLL_SECONDS=10
CLEANUP_POLL_SECONDS=600
WORKER_BATCH_SIZE=100
# Session advisory lock acquisition timeout, seconds.
POST_LOCK_TIMEOUT_SECONDS=10
# Bounded post retries (reminders are always attempted only once per claim).
TELEGRAM_RETRY_ATTEMPTS=3
TELEGRAM_RETRY_BASE_SECONDS=0.5
TELEGRAM_TIMEOUT_SECONDS=10
# Per-process pool sizing; allow headroom for dedicated advisory-lock connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Production entry point respects these. Dev compose uses HTTP port 8000.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Keep this separate port internal in production (no ingress route).
METRICS_HOST=0.0.0.0
METRICS_PORT=9000
# DEBUG / INFO / WARNING / ERROR / CRITICAL; json / console.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional. Empty DSN disables Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
