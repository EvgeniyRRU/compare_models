# --- Telegram ---
# Токен бота от @BotFather (секрет)
BOT_TOKEN=
# polling (локальная разработка) | webhook (production)
BOT_MODE=polling
# Только для webhook: публичный HTTPS URL, например https://example.com/telegram/webhook
WEBHOOK_URL=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (обязателен для webhook)
WEBHOOK_SECRET=
# ID чата разработчиков, куда публикуются обращения (бот должен быть в чате)
DEV_CHAT_ID=
# Публичный HTTPS URL Mini App (корень сервиса); пусто — кнопка меню не ставится
WEBAPP_URL=
# Telegram ID первичных админов через запятую; роль выдаётся при первом обращении к боту
BOOTSTRAP_ADMIN_IDS=

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/support_bot

# --- HTTP ---
# Порт /metrics (отдельно от основного, не выставлять наружу через ingress)
METRICS_PORT=9100
# Таймаут обработки одного апдейта, сек
UPDATE_TIMEOUT_SECONDS=25
# Максимальный возраст auth_date в initData Mini App, сек
INITDATA_MAX_AGE_SECONDS=3600

# --- Обращения ---
DRAFT_TTL_HOURS=24
PROCESSED_UPDATES_TTL_HOURS=48
# Интервалы напоминаний о невзятом обращении, минуты
REMINDER_CRITICAL_MINUTES=10
REMINDER_HIGH_MINUTES=30
REMINDER_MEDIUM_MINUTES=120
REMINDER_LOW_MINUTES=480

# --- Фоновые задачи (секунды) ---
REMINDER_POLL_SECONDS=30
POST_SYNC_POLL_SECONDS=15
CLEANUP_POLL_SECONDS=600
ADVISORY_LOCK_TIMEOUT_SECONDS=10

# --- Логирование и мониторинг ---
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
# Пусто — Sentry выключен
SENTRY_DSN=
ENVIRONMENT=dev
