# Пример конфигурации. Скопируйте в .env для локальной разработки (.env в git не попадает).
# В production все значения приходят из внешнего пайплайна как переменные окружения.
# Переменные окружения имеют приоритет над .env.

# ---------------------------------------------------------------- Telegram
# Токен бота от @BotFather (секрет).
BOT_TOKEN=123456789:replace-me
# webhook — production; polling — локальная разработка без публичного HTTPS.
BOT_MODE=polling
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (обязателен при BOT_MODE=webhook).
# Допустимы символы A-Z a-z 0-9 _ -, длина 1–256.
WEBHOOK_SECRET=
# Публичный HTTPS-URL webhook для `python -m support_bot.cli set-webhook`,
# например https://support-bot.example.com/telegram/webhook
WEBHOOK_URL=
# Публичный HTTPS-URL Mini App (со слешем на конце), например https://support-bot.example.com/app/
# Если задан, бот ставит кнопку меню и показывает кнопку открытия Mini App в личке.
WEBAPP_URL=
# Id чата разработчиков, куда публикуются посты обращений (у супергрупп начинается с -100).
DEV_CHAT_ID=-1001234567890
# Telegram ID первичных администраторов через запятую: получают роль admin при /start.
BOOTSTRAP_ADMIN_IDS=
# Таймаут обработки одного апдейта внутри запроса webhook, секунды.
UPDATE_TIMEOUT_SECONDS=25
# Ретраи запросов к Bot API (сетевые ошибки и 429 с учётом retry_after).
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_BACKOFF_BASE_SECONDS=1
TELEGRAM_BACKOFF_MAX_SECONDS=30

# ---------------------------------------------------------------- База данных
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_bot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Логировать SQL (только для отладки).
DB_ECHO=false

# ---------------------------------------------------------------- Форма создания обращения
# Черновики, не менявшиеся дольше этого срока, удаляются, часы.
DRAFT_TTL_HOURS=24

# ---------------------------------------------------------------- Синхронизация постов
# Период фоновой досинхронизации постов (обращения без поста или с отставшей версией), секунды.
POST_SYNC_INTERVAL_SECONDS=30
# Сколько ждать advisory lock поста при синхронизации сразу после изменения, секунды.
POST_SYNC_LOCK_TIMEOUT_SECONDS=10
POST_SYNC_BATCH_SIZE=50

# ---------------------------------------------------------------- Напоминания о невзятых обращениях
# Период опроса сработавших сроков, секунды.
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_BATCH_SIZE=100
# Интервалы напоминаний по приоритетам, минуты.
REMINDER_CRITICAL_MINUTES=10
REMINDER_HIGH_MINUTES=30
REMINDER_MEDIUM_MINUTES=120
REMINDER_LOW_MINUTES=480

# ---------------------------------------------------------------- Очистка
CLEANUP_INTERVAL_SECONDS=600
# Записи о обработанных апдейтах (дедупликация) старше этого срока удаляются, часы.
PROCESSED_UPDATES_TTL_HOURS=48

# ---------------------------------------------------------------- Mini App
# Максимальный возраст initData (auth_date), секунды.
INIT_DATA_MAX_AGE_SECONDS=86400

# ---------------------------------------------------------------- Логирование и мониторинг
LOG_LEVEL=INFO
# json — для OpenSearch; console — человекочитаемый формат для разработки.
LOG_FORMAT=console
# DSN Sentry (секрет). Пусто — Sentry отключён.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
# Порт отдельного HTTP-сервера /metrics (не публикуется через ingress).
METRICS_PORT=9000
