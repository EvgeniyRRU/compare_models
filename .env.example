# --- Telegram ---
# Токен бота из BotFather. Обязателен.
BOT_TOKEN=123456:replace-me
# webhook (production) или polling (локальная разработка).
BOT_MODE=polling
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token. Обязателен в режиме webhook.
TELEGRAM_WEBHOOK_SECRET=replace-me
# ID чата разработчиков (может быть отрицательным для супергрупп).
DEV_CHAT_ID=-1001234567890
# Telegram ID первичных администраторов через запятую. Получают роль admin при первом /start.
BOOTSTRAP_ADMIN_IDS=123456789,987654321

# --- Database ---
# Внутри docker compose хост называется db, локально — localhost.
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5433/support

# --- Mini App ---
# Публичный HTTPS-адрес Mini App. Если задан, бот ставит кнопку меню в личных чатах.
MINI_APP_URL=
# Максимальный возраст initData в секундах.
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Напоминания (минуты, зависят от приоритета) ---
REMINDER_CRITICAL_MINUTES=10
REMINDER_HIGH_MINUTES=30
REMINDER_MEDIUM_MINUTES=120
REMINDER_LOW_MINUTES=480
REMINDER_POLL_SECONDS=30
REMINDER_BATCH_SIZE=50

# --- Фоновая синхронизация постов ---
POST_SYNC_POLL_SECONDS=15
POST_SYNC_LOCK_TIMEOUT_SECONDS=10
POST_SYNC_BATCH_SIZE=20

# --- Очистка ---
CLEANUP_POLL_SECONDS=3600
DRAFT_TTL_HOURS=24
UPDATES_RETENTION_HOURS=48

# --- HTTP / webhook ---
WEBHOOK_TIMEOUT_SECONDS=25
WORKERS_ENABLED=true

# --- Логирование ---
LOG_LEVEL=INFO
# json для production/OpenSearch, console для разработки.
LOG_FORMAT=console

# --- Sentry (опционально) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Prometheus ---
METRICS_ENABLED=true
METRICS_PORT=9100