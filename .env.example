# Copy to .env for local development. Production gets these as env variables from the pipeline.
# Never commit real values.

# --- Database ---------------------------------------------------------------
# SQLAlchemy URL with asyncpg driver. Used by the app and by `alembic upgrade head`.
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5433/support_bot

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather. Also the key for Mini App initData validation.
BOT_TOKEN=123456:replace-me
# Chat where developers see tickets and reminders are sent (negative id for groups).
DEV_CHAT_ID=-1001234567890
# polling: local development, no public HTTPS needed. webhook: production.
BOT_MODE=polling
# Required when BOT_MODE=webhook: full public URL and a secret checked on every update.
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
# Public HTTPS URL of the Mini App (…/app/). Empty disables the menu button.
MINI_APP_URL=
# Comma-separated Telegram IDs that become admins on their first /start.
BOOTSTRAP_ADMIN_IDS=
# Max age of Mini App initData (seconds).
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Drafts, updates, timing -------------------------------------------------
# Draft form is dropped after this many hours without activity.
DRAFT_TTL_HOURS=24
# Upper bound for handling one update (seconds).
UPDATE_TIMEOUT_SECONDS=30
# How long processed_updates rows are kept for deduplication.
PROCESSED_UPDATES_RETENTION_HOURS=48

# --- Reminders (minutes) ------------------------------------------------------
REMINDER_CRITICAL_MINUTES=10
REMINDER_HIGH_MINUTES=30
REMINDER_MEDIUM_MINUTES=120
REMINDER_LOW_MINUTES=480
# How often the reminder worker checks for due tickets (seconds).
REMINDER_POLL_SECONDS=30

# --- Post sync ---------------------------------------------------------------
# How often the background pass looks for posts that are out of date (seconds).
POST_SYNC_POLL_SECONDS=30
# How long a sync waits for the advisory lock of a ticket (seconds).
POST_SYNC_LOCK_TIMEOUT_SECONDS=10

# --- HTTP and metrics ---------------------------------------------------------
# Prometheus metrics are served here, not on HTTP_PORT, so they are not exposed via ingress.
METRICS_PORT=9100

# --- Logging and monitoring ---------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json for OpenSearch/production, console for local reading.
LOG_FORMAT=console
# Sentry is disabled when this is empty.
SENTRY_DSN=
